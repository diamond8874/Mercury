# ---------------------------------------------------------------------------
# Mercury environment configuration
# Copy to `.env` (which is gitignored) and fill in what you need.
# ---------------------------------------------------------------------------

# --- Option A: generic, provider-agnostic (recommended) --------------------
# The provider is auto-detected from the key prefix, so usually this is all
# you need. Set LLM_API_KEY=MOCK to run entirely offline with no API calls.
LLM_API_KEY=

# Optional overrides. Leave blank to use the registry defaults.
#   LLM_PROVIDER: openai | anthropic | nvidia | google | groq | openrouter |
#                 deepseek | mistral | together | fireworks | xai | perplexity |
#                 cerebras | cohere | ollama | lmstudio | custom
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# --- Option B: per-vendor keys (used as fallbacks) -------------------------
# Any one of these is picked up automatically when LLM_API_KEY is unset.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=

# --- Option C: a local / self-hosted OpenAI-compatible server --------------
# Ollama, LM Studio, vLLM, llama.cpp, LocalAI, text-generation-webui...
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=not-needed

# --- Tuning ----------------------------------------------------------------
# MAX_CHARTS=6
# PROFILE_WAIT_TIMEOUT=180

# ---------------------------------------------------------------------------
# Deployment (see DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production          # enables strict cookies + HSTS, forbids debug
# SECRET_KEY=                     # REQUIRED in production; 64 hex chars
#                                 # python -c "import secrets;print(secrets.token_hex(32))"

# Storage - mount DATA_DIR on a persistent volume
# DATA_DIR=/var/lib/mercury
# MAX_UPLOAD_MB=16

# Retention: sweep old sessions so disk does not fill (0 disables)
# RETENTION_DAYS=7
# MAX_SESSIONS=0

# Security
# MERCURY_API_TOKEN=              # if set, every /api/* call needs X-API-Key
# TRUSTED_PROXY_COUNT=1           # reverse proxies to trust X-Forwarded-* from
# CORS_ORIGINS=                   # comma-separated allowlist; empty = same-origin

# Server
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=0                   # MUST be 0 in production (RCE via Werkzeug console)
# LOG_LEVEL=INFO
