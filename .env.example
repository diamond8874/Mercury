# NVIDIA Endpoint Configuration (Legacy Default)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Multi-Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Default Provider & Model configuration (Optional overrides)
# Supported LLM_PROVIDER options: nvidia, openai, anthropic, gemini, openrouter, ollama
LLM_PROVIDER=nvidia
LLM_MODEL=z-ai/glm-5.2
